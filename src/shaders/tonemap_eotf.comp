#version 450
// Stage 4 — Tonemap + EOTF
// Called ONLY for FG pipeline (SR-only path skips this stage entirely)
// Per DLSS FG §HDR: FG requires display-ready (tonemapped + EOTF encoded) backbuffer input

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Input: scene-linear HDR (R16G16B16A16_SFLOAT)
layout(set = 0, binding = 0) uniform sampler2D srcLinear;

// Output: display-ready (sRGB encoded LDR or PQ encoded HDR)
layout(set = 0, binding = 1, rgba8) uniform image2D dstDisplay;

layout(push_constant) uniform PushConstants {
    int mode;  // 0 = LDR (sRGB EOTF only), 1 = HDR (ACES Filmic + PQ ST.2084)
} pc;

// --- sRGB EOTF (linear → sRGB encoded) ---
// Per IEC 61966-2-1
vec3 srgbEotf(vec3 linear) {
    // LDR path: clamp first (values > 1 are out of SDR range)
    vec3 c = clamp(linear, vec3(0.0), vec3(1.0));
    return mix(
        c * 12.92,
        pow(c, vec3(1.0 / 2.4)) * 1.055 - vec3(0.055),
        step(vec3(0.0031308), c)
    );
}

// --- ACES Filmic Tonemap (Krzysztof Narkowicz approximation) ---
// Reference: https://knarkowicz.wordpress.com/2016/01/06/aces-filmic-tone-mapping-curve/
// Maps scene-linear [0, infinity) → [0, 1], monotonic and invertible
vec3 acesFilmic(vec3 x) {
    const float a = 2.51;
    const float b = 0.03;
    const float c = 2.43;
    const float d = 0.59;
    const float e = 0.14;
    return clamp(
        (x * (a * x + vec3(b))) / (x * (c * x + vec3(d)) + vec3(e)),
        0.0, 1.0
    );
}

// --- PQ (ST.2084) EOTF ---
// Reference: ITU-R BT.2100, SMPTE ST.2084
// Blender convention: 1.0 scene-linear = 100 nits diffuse white
// PQ normalized: L_PQ = L_nits / 10000
// Per Blender displays_views.rst:271-272: 1.0 scene-linear = 100 nits
vec3 pqEotf(vec3 linear_scene) {
    const float m1 = 0.1593017578125;
    const float m2 = 78.84375;
    const float c1 = 0.8359375;
    const float c2 = 18.8515625;
    const float c3 = 18.6875;

    // Convert scene-linear to nits: 1.0 = 100 nits → L_norm = linear * 0.01
    vec3 L = linear_scene * 0.01;  // = nits / 10000
    L = max(L, vec3(0.0));

    vec3 Lm1 = pow(L, vec3(m1));
    return pow((vec3(c1) + c2 * Lm1) / (vec3(1.0) + c3 * Lm1), vec3(m2));
}

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dstDisplay);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    vec4 linear = texture(srcLinear, uv);

    vec3 result;

    if (pc.mode == 0) {
        // LDR path: clamp to [0,1] + sRGB EOTF (no tonemap)
        // Per user decision: LDR projects use sRGB EOTF only, no ACES
        result = srgbEotf(linear.rgb);
    } else {
        // HDR path: ACES Filmic tonemap + PQ ST.2084 EOTF
        // DLSS FG §HDR L1448-1500: FG needs display-ready HDR (PQ encoded)
        vec3 tonemapped = acesFilmic(linear.rgb);
        result = pqEotf(tonemapped);
    }

    imageStore(dstDisplay, coord, vec4(result, linear.a));
}
