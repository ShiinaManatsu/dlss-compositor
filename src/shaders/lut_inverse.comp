#version 450
// Stage 6 alternative — 3D LUT inverse for Blender/OCIO display transforms.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D srcDisplay;
layout(set = 0, binding = 1) uniform sampler3D inverseLut;
layout(set = 0, binding = 2, rgba16f) uniform image2D dstLinear;

layout(push_constant) uniform PushConstants {
    vec4 domainMin;
    vec4 domainScale;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dstLinear);
    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    vec4 display = texture(srcDisplay, uv);
    vec3 lutCoord = clamp((display.rgb - pc.domainMin.rgb) * pc.domainScale.rgb, vec3(0.0), vec3(1.0));
    vec3 linear = texture(inverseLut, lutCoord).rgb;
    imageStore(dstLinear, coord, vec4(linear, display.a));
}
