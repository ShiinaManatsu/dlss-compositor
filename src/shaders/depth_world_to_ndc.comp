#version 450
// DLSS SR §3.5 - DLSS expects depth in NDC [0, 1] range, non-inverted
// Blender Cycles Z pass: world-linear distance (NOT NDC, NOT reverse-Z)
// This shader converts Blender world-linear Z → NDC [0, 1] for DLSS SR input

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Input: world-linear depth from Blender
layout(set = 0, binding = 0) uniform sampler2D srcDepth;

// Output: NDC depth [0, 1] for DLSS SR
layout(set = 0, binding = 1, r32f) uniform image2D dstDepth;

// Push constants: projection matrix from dlssconfig per-frame camera data
layout(push_constant) uniform PushConstants {
    mat4 projection;  // Camera projection matrix from dlssconfig
    float near;       // Camera near clip
    float far;        // Camera far clip
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dstDepth);

    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    float zWorld = texture(srcDepth, uv).r;

    // DLSS SR §3.5 - depth in NDC [0, 1] range, non-inverted
    // Blender: Z is positive world-space distance from camera
    // Standard perspective projection: NDC_Z = (z * proj[2][2] + proj[3][2]) / z
    // For Blender camera: use full projection matrix path (a)

    // Method (a): use projection matrix for proper perspective conversion
    // clip = projection * vec4(0, 0, -zWorld, 1.0)  (Blender uses -Z forward)
    // ndc.z = clip.z / clip.w

    // Convert world-linear Z to clip space
    // Blender camera looks down -Z axis in view space
    float viewZ = -zWorld;  // Negate: world distance → view space Z (negative)

    // Apply projection: clip_z = proj[2][2] * viewZ + proj[3][2]
    //                   clip_w = proj[2][3] * viewZ + proj[3][3]
    float clip_z = pc.projection[2][2] * viewZ + pc.projection[3][2];
    float clip_w = pc.projection[2][3] * viewZ + pc.projection[3][3];

    float ndcZ = 0.0;
    if (abs(clip_w) > 1e-6) {
        ndcZ = clip_z / clip_w;
        // Remap from [-1, 1] to [0, 1] for Vulkan/DLSS NDC convention
        ndcZ = ndcZ * 0.5 + 0.5;
    }

    // Clamp to valid NDC range [0, 1]
    ndcZ = clamp(ndcZ, 0.0, 1.0);

    imageStore(dstDepth, coord, vec4(ndcZ, 0.0, 0.0, 1.0));
}
