#version 450

// Compute shader: CAS-inspired unsharp mask sharpening.
// Reads SR output, applies sharpening, writes to output buffer.
// sharpness = 0.0 means no change (bypass handled at C++ level).
// sharpness = 1.0 means full CAS strength.
//
// Algorithm: output = input + sharpness * (input - blur(input))
// where blur is a 3x3 box filter approximation using 4 corner samples.

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

layout(set = 0, binding = 0, rgba16f) uniform readonly  image2D inputImage;
layout(set = 0, binding = 1, rgba16f) uniform writeonly image2D outputImage;

layout(push_constant) uniform PushConstants {
    int imageWidth;
    int imageHeight;
    float sharpness;  // [0.0, 1.0]
    int _pad;
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= pc.imageWidth || coord.y >= pc.imageHeight) {
        return;
    }

    vec4 center = imageLoad(inputImage, coord);

    // Sample 4 cross neighbors for sharpening kernel
    vec4 top    = imageLoad(inputImage, clamp(coord + ivec2( 0, -1), ivec2(0), ivec2(pc.imageWidth - 1, pc.imageHeight - 1)));
    vec4 bottom = imageLoad(inputImage, clamp(coord + ivec2( 0,  1), ivec2(0), ivec2(pc.imageWidth - 1, pc.imageHeight - 1)));
    vec4 left   = imageLoad(inputImage, clamp(coord + ivec2(-1,  0), ivec2(0), ivec2(pc.imageWidth - 1, pc.imageHeight - 1)));
    vec4 right  = imageLoad(inputImage, clamp(coord + ivec2( 1,  0), ivec2(0), ivec2(pc.imageWidth - 1, pc.imageHeight - 1)));

    // Approximate blur: average of 4 cross neighbors
    vec4 blur = (top + bottom + left + right) * 0.25;

    // Unsharp mask: center + sharpness * (center - blur)
    vec3 sharpened = center.rgb + pc.sharpness * (center.rgb - blur.rgb);

    // Preserve alpha, allow HDR values (no clamp to preserve scene-linear range)
    imageStore(outputImage, coord, vec4(sharpened, center.a));
}
