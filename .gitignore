# RAM disk scratch (never map a RAM disk inside the repo; patterns catch leftovers)
ramdisk/
ramtmp/
*.exr

# Test frames: rendered frames/outputs are not committed; configs + SOURCE.md are
test-frames/*.png
test-frames/*.jpg
test-frames/*.jpeg
test-frames/*.mov
test-frames/rr/luts/
test-frames/rr/pipeline-out/
test-frames/rr/*.png
test-frames/rr/*.mov

# Misc runtime scratch
tmp/
imgui.ini

# Large third-party reference drops (kept on disk, outside git)
docs/external/
