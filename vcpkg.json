{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg-tool/main/docs/vcpkg.schema.json",
  "name": "dlss-compositor",
  "version": "2.0.0",
  "description": "Headless DLSS Super-Resolution + Frame-Generation compute compositor.",
  "homepage": "https://github.com/heshiyu/dlss-compositor",
  "dependencies": [
    "nlohmann-json",
    "openexr",
    "openimageio",
    "spdlog",
    "zlib",
    "volk",
    "vulkan-memory-allocator",
    {
      "name": "glslang",
      "features": ["tools"]
    },
    {
      "name": "ffmpeg",
      "features": ["nvcodec"]
    }
  ]
}
