{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-cli",
      "type": "shell",
      "command": "cmake --build build --config Release --parallel",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "build-flutter",
      "type": "shell",
      "command": "flutter build windows --debug",
      "options": {
        "cwd": "${workspaceFolder}/gui"
      },
      "group": "build"
    }
  ]
}
