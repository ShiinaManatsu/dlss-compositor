{
  "name": "dlss-compositor-app",
  "private": true,
  "version": "0.5.9",
  "description": "DLSS SR/RR/FG compositor GUI",
  "author": {
    "name": "dlss-compositor"
  },
  "type": "module",
  "main": "out/main.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "pack:backend": "node scripts/pack-backend.mjs",
    "dist:dir": "npm run build && npm run pack:backend && electron-builder --win --dir && node scripts/seed-nr.mjs",
    "dist": "npm run build && npm run pack:backend && electron-builder --win nsis zip && node scripts/seed-nr.mjs",
    "test:rpc": "node --experimental-strip-types scripts/test-rpc.mjs",
    "test:progress": "node --experimental-strip-types scripts/test-progress.mjs",
    "test:dcp": "node --experimental-strip-types scripts/test-dcp.mjs",
    "test:errors": "node --experimental-strip-types scripts/test-errors.mjs"
  },
  "dependencies": {
    "@react-spectrum/s2": "^1.5.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@react-aria/optimize-locales-plugin": "latest",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^36.4.0",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.25.5",
    "lightningcss": "^1.30.0",
    "typescript": "^5.8.0",
    "unplugin-parcel-macros": "latest",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "com.dlsscompositor.app",
    "productName": "DLSS Compositor",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "dist/**/*",
      "!**/node_modules/**"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "pack/backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "include": "scripts/installer.nsh",
      "artifactName": "DLSS-Compositor-Setup-${version}.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "dcp",
        "name": "DLSS Compositor Project",
        "description": "DLSS Compositor \u5de5\u7a0b\u6587\u4ef6",
        "role": "Editor"
      }
    ]
  }
}
