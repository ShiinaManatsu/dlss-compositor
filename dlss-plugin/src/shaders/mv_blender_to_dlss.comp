#version 450
// DLSS SR/FG §3.6/§6 - per-pixel motion vectors curr→prev in pixel-units.
// Blender Vector.X/Y exported by the File Output VECTOR socket already have
// the horizontal sign DLSS expects for curr→prev pixel-units. DLSS uses the
// same +X/right screen convention, and +Y/down requires one vertical flip here.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Input: Blender Vector pass packed as RGBA (Vector.X=R, Vector.Y=G,
// Vector.Z=B, Vector.W=A)
layout(set = 0, binding = 0) uniform sampler2D srcMV4ch;

// Output: DLSS 2-channel motion vectors (X=R, Y=G), pixel units
layout(set = 0, binding = 1, rg16f) uniform image2D dstMV2ch;

void main() {
  ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
  ivec2 size = imageSize(dstMV2ch);

  if (coord.x >= size.x || coord.y >= size.y)
    return;

  // Read 4-channel Blender Vector pass
  // Channels: X/Y are the current-frame vector back toward the previous frame
  // in Blender's exported sign convention; Z/W point to the other temporal
  // neighbor and are not used for DLSS curr→prev input.
  vec4 blender = texelFetch(srcMV4ch, coord, 0);

  vec2 dlss = vec2(blender.x, -blender.y);

  // Store 2-channel DLSS MV (RG16F format)
  imageStore(dstMV2ch, coord, vec4(dlss, 0.0, 0.0));
}
