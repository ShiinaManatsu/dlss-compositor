#version 450
// DLSS SR §3.5 / FG §6 - depth is supplied non-inverted: near=0, far=1.
// Blender Cycles Z pass is physical camera depth in scene units: near objects
// approach 0, far objects approach camera far. Use the per-frame camera near/far
// from dlssconfig to normalize this Blender depth into DLSS' expected range.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

// Input: world-linear depth from Blender
layout(set = 0, binding = 0) uniform sampler2D srcDepth;

// Output: NDC depth [0, 1] for DLSS SR
layout(set = 0, binding = 1, r32f) uniform image2D dstDepth;

// Push constants: projection matrix from dlssconfig per-frame camera data
layout(push_constant) uniform PushConstants {
    mat4 projection;  // Camera projection matrix from dlssconfig
    float near;       // Camera near clip
    float far;        // Camera far clip
} pc;

void main() {
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(dstDepth);

    if (coord.x >= size.x || coord.y >= size.y) return;

    vec2 uv = (vec2(coord) + 0.5) / vec2(size);
    float zWorld = texture(srcDepth, uv).r;

    float denom = max(pc.far - pc.near, 1e-6);
    float ndcZ = clamp((zWorld - pc.near) / denom, 0.0, 1.0);

    imageStore(dstDepth, coord, vec4(ndcZ, 0.0, 0.0, 1.0));
}
